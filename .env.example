# Copy to .env and fill in real values. .env is gitignored; this file is the
# documentation of what the app needs. Never put real keys in here.

# Postgres. Local default matches docker-compose.yml. In production use the Neon
# connection string (postgres://...?...sslmode=require); keep it in Render's env only.
DATABASE_URL=postgresql+psycopg://cic:cic@localhost:5432/cic

# dev | test | prod
APP_ENV=dev
# Secure cookies need HTTPS. Browsers accept them on http://localhost too; set
# false only if you test over plain http on another host.
COOKIE_SECURE=true

# Donor messages: dry_run records sends and delivers nothing. live needs a provider key.
MESSAGING_MODE=dry_run
# DEMO_MODE=true enables `python -m app.cli seed-demo` / `reset-demo`. Never in real use.
DEMO_MODE=false
