{
  "name": "cic-compass-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:dashboard": "node tests/dashboard.browser.mjs",
    "test:dashboard:live": "node tests/dashboard-live.browser.mjs",
    "test:entry": "tsc -p tsconfig.tests.json && node --test tests/donor-entry.test.mjs",
    "test:entry:browser": "node tests/entry.browser.mjs",
    "test:contact": "node tests/contact.browser.mjs",
    "test:detail": "node tests/detail.browser.mjs",
    "test:directory": "node tests/directory.browser.mjs",
    "test:ledger": "node --test tests/ledger-accessibility.test.mjs",
    "test:updates": "tsc -p tsconfig.tests.json && node --test tests/donor-updates.test.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write src",
    "gen:api": "openapi-typescript src/api/openapi.json -o src/api/types.ts",
    "test:import": "tsc -p tsconfig.tests.json && node --test tests/import.test.mjs",
    "test:import:browser": "node tests/import.browser.mjs",
    "test:import:live": "node tests/import-live.browser.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
